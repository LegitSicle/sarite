#!/usr/bin/env php
<?php
$autoloadPath = $GLOBALS['_composer_autoload_path'] ?? getcwd() . "/vendor/autoload.php";
require_once $autoloadPath;
use sarite\data\Database;

$dbConfig = [
    "migrations" => $_ENV["DB_MIGRATIONS"],
    "host" => $_ENV["DB_HOST"],
    "port" => $_ENV["DB_PORT"],
    "name" => $_ENV["DB_NAME"],
    "user" => $_ENV["DB_USER"],
    "password" => $_ENV["DB_PASSWORD"],
];
if (in_array("--init_db", $argv, true)) {
    Database::initialize($dbConfig);
}
$database = new Database($dbConfig);
$database->migrate();